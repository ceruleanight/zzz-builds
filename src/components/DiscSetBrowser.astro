---
import { rankLabel } from '../utils/rank';
import { t } from '../utils/i18n';

type OwnedUsage = {
  characterId: string;
  characterName: string;
  characterRarity: string;
  href: string;
  isWip: boolean;
  pieces: 2 | 4;
  slots: {
    key: string;
    label: string;
    stats: { id: string; label: string; rank: number }[];
  }[];
  substats: { id: string; label: string; rank: number }[];
};

type DiscSetBrowserData = {
  agentDefaults: Record<string, { sets: string[]; stats: Record<string, string[]> }>;
  allSubstats: { id: string; label: string }[];
  characters: {
    id: string;
    name: string;
    rarity: string;
    element: string;
    elementLabel: string;
  }[];
  discSets: {
    usageIds: string[];
    ownedUsage: OwnedUsage[];
    id: string;
    image: string;
    name: string;
    rarity: number;
    versionReleased: string;
    bonuses: {
      id: string;
      label: string;
      html: string;
    }[];
    tags: string[];
    tagGroups: string[];
    fourPieceUsage: {
      characterName: string;
      characterRarity: string;
      href: string;
      isWip?: boolean;
      rank?: number;
      popoverHtml?: string;
    }[];
    twoPieceUsage: {
      characterName: string;
      characterRarity: string;
      href: string;
      isWip?: boolean;
      rank?: number;
      popoverHtml?: string;
    }[];
  }[];
  rarities: number[];
  tagOptionGroups: {
    label: string;
    options: {
      id: string;
      label: string;
    }[];
  }[];
};

const { data, locale, agentsHref } = Astro.props as {
  data: DiscSetBrowserData;
  locale: any;
  agentsHref: string;
};

const allLabel = t(locale, 'ui', 'All');
const resultsLabel = t(locale, 'ui', 'Results');
const noResultsLabel = t(locale, 'ui', 'No disc sets found', undefined, false);
const searchByNameLabel = t(locale, 'ui', 'Search by name');
const searchByCharacterNameLabel = t(
  locale,
  'ui',
  'Search by character name',
  undefined,
  false,
);
const filterByDiscSetsLabel = t(locale, 'ui', 'Filter by disc sets', undefined, false);
const selectAllDiscSetsLabel = t(locale, 'ui', 'Select all disc sets', undefined, false);
const clearAllDiscSetsLabel = t(locale, 'ui', 'Clear all disc sets', undefined, false);
const discSetsSelectedLabel = t(locale, 'ui', 'Disc sets selected', undefined, false);
const rarityLabel = t(locale, 'ui', 'Rarity');
const searchLabel = t(locale, 'ui', 'Search');
const tagLabel = t(locale, 'ui', 'Set Effect', undefined, false);
const discSetsLabel = t(locale, 'ui', 'Discs Sets', undefined, false);
const previewLabel = t(locale, 'ui', 'Preview', undefined, false);
const sortByLabel = t(locale, 'ui', 'Sort by', undefined, false);
const releaseDateLabel = t(locale, 'ui', 'Release date', undefined, false);
const newestLabel = t(locale, 'ui', 'Newest', undefined, false);
const sortOptions = [
  { value: 'name', label: `${discSetsLabel} - A-Z` },
  { value: 'release', label: `${releaseDateLabel} - ${newestLabel}` },
];
const mentionedOnLabel = t(locale, 'ui', 'Disc set mentioned on', undefined, false);
const mentionedOnTwoLabel = t(locale, 'ui', 'Disc set mentioned on 2', undefined, false);
const ui = (id: string) => t(locale, 'ui', id, undefined, false);
const rosterOptions = [
  { value: '', label: ui('Roster all') },
  { value: 'needed', label: ui('Roster needed') },
  { value: 'unneeded', label: ui('Roster unneeded') },
];
const noMentionsLabel = t(locale, 'ui', 'No disc set mentions', undefined, false);
---

<section class="disc-set-browser" data-disc-browser>
  <div
    class="disc-roster-bar"
    data-roster-panel
    data-known-ids={data.characters.map((character) => character.id).join(' ')}
    data-character-index={JSON.stringify(
      data.characters.map(({ id, name }) => ({ id, name })),
    )}
    data-defaults={JSON.stringify(data.agentDefaults)}
    data-all-substats={JSON.stringify(data.allSubstats)}
    data-label-keep-substats={ui('Roster substats keep')}
    data-label-unneeded-substats={ui('Roster substats unneeded')}
    data-msg-no-unneeded-substats={ui('Roster substats none unneeded')}
    data-msg-no-agents={ui('Roster no agents')}
    data-label-two={ui('2-piece')}
    data-label-four={ui('4-piece')}
    data-msg-not-needed={ui('Roster not needed')}
  >
    <p class="disc-roster-bar-count">
      <strong>{ui('My Agents')}:</strong>
      <span><strong data-roster-count>0</strong> / {data.characters.length} {ui('My agents selected')}</span>
      <a class="disc-roster-button" href={agentsHref}>{ui('Plan edit')}</a>
    </p>
    <label class="disc-roster-mode">
      <span>{ui('Roster stats shown')}</span>
      <select data-roster-mode aria-label={ui('Roster stats shown')}>
        <option value="all">{ui('Roster stats all')}</option>
        <option value="top">{ui('Roster stats top')}</option>
      </select>
    </label>
    <label class="disc-roster-mode disc-roster-check">
      <input type="checkbox" data-roster-hide-names />
      <span>{ui('Roster hide names')}</span>
    </label>
    <label class="disc-roster-mode disc-roster-check">
      <input type="checkbox" data-roster-hide-ranked />
      <span>{ui('Roster hide ranked')}</span>
    </label>
  </div>

  <div class="disc-roster-views" role="group" aria-label={ui('Roster view label')}>
    <button type="button" class="disc-roster-view" data-roster-view="" aria-pressed="true">
      {ui('Roster all')} <span data-roster-view-count></span>
    </button>
    <button type="button" class="disc-roster-view is-keep" data-roster-view="needed" aria-pressed="false">
      {ui('Roster view keep')} <span data-roster-view-count></span>
    </button>
    <button type="button" class="disc-roster-view is-remove" data-roster-view="unneeded" aria-pressed="false">
      {ui('Roster view remove')} <span data-roster-view-count></span>
    </button>
  </div>

  <form class="home-filters disc-set-filters" id="disc-set-filters" data-disc-filters>
    <label class="home-search">
      {searchLabel}
      <input type="search" name="search" placeholder={searchByNameLabel} autocomplete="off" />
    </label>

    <label class="home-search">
      {searchLabel}
      <input
        type="search"
        name="character"
        placeholder={searchByCharacterNameLabel}
        autocomplete="off"
      />
    </label>

    <div class="home-select-filter">
      {rarityLabel}
      <select class="home-native-select" name="rarity" aria-label={rarityLabel}>
        <option value="">{allLabel}</option>
        {
          data.rarities.map((rarity) => (
            <option value={String(rarity)}>
              {rankLabel(rarity)}
            </option>
          ))
        }
      </select>
    </div>

    <select name="roster" hidden aria-hidden="true" tabindex="-1">
      {rosterOptions.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))}
    </select>

    <div class="home-select-filter">
      {tagLabel}
      <select class="home-native-select" name="tagGroups" aria-label={tagLabel}>
        <option value="">{allLabel}</option>
        {
          data.tagOptionGroups.map((group) => (
            <optgroup label={group.label}>
              {group.options.map((tag) => (
                <option value={tag.id}>{tag.label}</option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </div>

    <details class="disc-set-selection">
      <summary>
        <span>{filterByDiscSetsLabel}</span>
        <span
          data-disc-set-selection-count
          data-label-selected={discSetsSelectedLabel}
          aria-live="polite"
        ></span>
      </summary>
      <div class="disc-set-selection-tools">
        <button type="button" class="disc-roster-button" data-disc-set-select-all>
          {selectAllDiscSetsLabel}
        </button>
        <button type="button" class="disc-roster-button" data-disc-set-clear-all>
          {clearAllDiscSetsLabel}
        </button>
      </div>
      <div class="disc-set-selection-list">
        {
          data.discSets.map((discSet) => (
            <label class="disc-set-selection-option is-selected">
              <input
                type="checkbox"
                name="discSet"
                value={discSet.id}
                checked
              />
              {discSet.image ? (
                <img
                  class="disc-set-selection-icon"
                  src={discSet.image}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width={36}
                  height={36}
                />
              ) : (
                <span class="disc-set-selection-icon is-placeholder" aria-hidden="true">
                  {discSet.name.charAt(0)}
                </span>
              )}
              <span>{discSet.name}</span>
            </label>
          ))
        }
      </div>
    </details>
  </form>

  <div class="disc-set-browser-header">
    <p data-disc-count data-results-label={resultsLabel} aria-live="polite">
      {data.discSets.length}
      {resultsLabel}
    </p>
    <label class="roster-sort">
      {sortByLabel}
      <select class="home-native-select" name="sort" form="disc-set-filters" aria-label={sortByLabel}>
        {
          sortOptions.map((option) => (
            <option value={option.value} selected={option.value === 'name'}>
              {option.label}
            </option>
          ))
        }
      </select>
    </label>
  </div>

  <div class="disc-set-grid" data-disc-grid>
    {
      data.discSets.map((discSet) => (
        <article
          class={`disc-set-entry rarity-${discSet.rarity}`}
          data-disc-card
          data-id={discSet.id}
          data-name={discSet.name}
          data-rarity={discSet.rarity}
          data-tags={discSet.tags.join(' ')}
          data-tag-groups={discSet.tagGroups.join(' ')}
          data-version-released={discSet.versionReleased}
          data-usage-ids={discSet.usageIds.join(' ')}
          data-character-names={data.characters
            .filter((character) => discSet.usageIds.includes(character.id))
            .map((character) => character.name)
            .join(' ')}
          data-roster="unneeded"
        >
          <header class="disc-set-entry-header">
            <div class="disc-set-entry-title">
              <div class={`disc-set-entry-image${discSet.image ? '' : ' is-empty'}`}>
                {discSet.image ? (
                  <img
                    src={discSet.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width={72}
                    height={72}
                    referrerpolicy="no-referrer"
                  />
                ) : (
                  <span class="image-placeholder" aria-hidden="true">
                    {discSet.name.charAt(0)}
                  </span>
                )}
              </div>
              <div>
                <h2>{discSet.name}</h2>
              </div>
            </div>
            <span class="disc-set-entry-rarity">
              {rankLabel(discSet.rarity)}
            </span>
          </header>

          <div class="disc-set-bonus-list">
            {discSet.bonuses.map((bonus) => (
              <section class="disc-set-bonus" aria-label={`${discSet.name} ${bonus.label}`}>
                <h3>{bonus.label}</h3>
                <div set:html={bonus.html} />
              </section>
            ))}
          </div>

          {(discSet.fourPieceUsage.length > 0 || discSet.twoPieceUsage.length === 0) && (
          <section class="disc-set-usage" aria-label={`${discSet.name} ${mentionedOnLabel}`}>
            <h3>{mentionedOnLabel}</h3>
            {discSet.fourPieceUsage.length > 0 ? (
              <div class="disc-set-usage-list">
                {discSet.fourPieceUsage.map((usage) => (
                  <span class="disc-set-usage-item">
                    <a
                      class={`disc-set-usage-chip character-rarity-${usage.characterRarity}${usage.isWip ? ' is-wip' : ''}${usage.popoverHtml ? ' has-preview' : ''}`}
                      href={usage.href}
                      data-usage-popover-html={usage.popoverHtml || undefined}
                    >
                      {(usage.rank || usage.isWip) && (
                        <strong class="usage-rank-number">{usage.isWip ? 'WIP' : usage.rank}</strong>
                      )}
                      <span class="disc-set-usage-character">{usage.characterName}</span>
                    </a>
                    {usage.popoverHtml && (
                      <button
                        type="button"
                        class={`disc-set-usage-preview character-rarity-${usage.characterRarity}`}
                        data-usage-preview
                        aria-expanded="false"
                        aria-label={`${previewLabel}: ${usage.characterName}`}
                      >
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                          <circle cx="8" cy="8" r="6.2" />
                          <path d="M8 7.2v4" />
                          <path d="M8 4.7v.1" />
                        </svg>
                      </button>
                    )}
                  </span>
                ))}
              </div>
            ) : (
              <p class="disc-set-usage-empty">{noMentionsLabel}</p>
            )}
          </section>
          )}
          {discSet.twoPieceUsage.length > 0 && (
          <section class="disc-set-usage" aria-label={`${discSet.name} ${mentionedOnTwoLabel}`}>
            <h3>{mentionedOnTwoLabel}</h3>
            {discSet.twoPieceUsage.length > 0 ? (
              <div class="disc-set-usage-list">
                {discSet.twoPieceUsage.map((usage) => (
                  <span class="disc-set-usage-item">
                    <a
                      class={`disc-set-usage-chip character-rarity-${usage.characterRarity}${usage.isWip ? ' is-wip' : ''}${usage.popoverHtml ? ' has-preview' : ''}`}
                      href={usage.href}
                      data-usage-popover-html={usage.popoverHtml || undefined}
                    >
                      {(usage.rank || usage.isWip) && (
                        <strong class="usage-rank-number">{usage.isWip ? 'WIP' : usage.rank}</strong>
                      )}
                      <span class="disc-set-usage-character">{usage.characterName}</span>
                    </a>
                    {usage.popoverHtml && (
                      <button
                        type="button"
                        class={`disc-set-usage-preview character-rarity-${usage.characterRarity}`}
                        data-usage-preview
                        aria-expanded="false"
                        aria-label={`${previewLabel}: ${usage.characterName}`}
                      >
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                          <circle cx="8" cy="8" r="6.2" />
                          <path d="M8 7.2v4" />
                          <path d="M8 4.7v.1" />
                        </svg>
                      </button>
                    )}
                  </span>
                ))}
              </div>
            ) : (
              <p class="disc-set-usage-empty">{noMentionsLabel}</p>
            )}
          </section>
          )}

          <section
            class="disc-set-owned"
            data-owned-panel
            data-usage-json={JSON.stringify(discSet.ownedUsage)}
            hidden
            aria-label={`${discSet.name} ${ui('My Agents')}`}
          >
            <h3>{ui('My Agents')}</h3>
            <p class="disc-set-owned-empty" data-owned-empty hidden></p>
            <p class="disc-set-owned-agents" data-owned-agents hidden></p>
            <div class="disc-set-owned-slots" data-owned-slots></div>
            <div class="disc-set-owned-substats" data-owned-substats></div>
          </section>
        </article>
      ))
    }
  </div>

  <p class="disc-set-empty" data-disc-empty hidden>{noResultsLabel}</p>
</section>

<script>
  import '../scripts/card-filters';
  import '../scripts/disc-usage-popover';
  import '../scripts/disc-roster';
  import '../scripts/disc-masonry';
</script>
