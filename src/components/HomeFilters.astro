---
import { rankLabel } from '../utils/rank';
import { t } from '../utils/i18n';

const { latestVersion = '', locale, recentlyUpdatedCount = 0 } = Astro.props;
const hasRecentUpdates = recentlyUpdatedCount > 0;
const recentlyUpdatedLabel = t(
  locale,
  'ui',
  'Recently updated',
  undefined,
  false,
);
const versionLabel = t(locale, 'ui', 'Version', undefined, false);
const versionText = latestVersion ? `${versionLabel} ${latestVersion}` : '';

// Filter options mirror metadata values written onto each character card.
const elements = [
  'electric',
  'ether',
  'fire',
  'ice',
  'lumiflux',
  'physical',
  'wind',
];
const rarities = ['4', '5'];
const specialties = [
  'anomaly',
  'armorer',
  'attack',
  'defense',
  'rupture',
  'stun',
  'support',
];
const allLabel = t(locale, 'ui', 'All');

const elementOptions = [
  { value: '', label: allLabel },
  ...elements.map((element) => ({
    value: element,
    label: t(locale, 'element', element),
  })),
];
const rarityOptions = [
  { value: '', label: allLabel },
  ...rarities.map((rarity) => ({
    value: rarity,
    label: rankLabel(rarity),
  })),
];
const specialtyOptions = [
  { value: '', label: allLabel },
  ...specialties.map((specialty) => ({
    value: specialty,
    label: t(locale, 'ui', specialty),
  })),
];
---

<form class="home-filters" id="character-filters" data-character-filters>
  <label class="home-search">
    {t(locale, 'ui', 'Search')}
    <input
      type="search"
      name="search"
      placeholder={t(locale, 'ui', 'Search by name')}
      autocomplete="off"
    />
  </label>

  <div class="home-select-filter">
    {t(locale, 'ui', 'Element')}
    <select
      class="home-native-select"
      name="element"
      aria-label={t(locale, 'ui', 'Element')}
    >
      {
        elementOptions.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))
      }
    </select>
  </div>

  <div class="home-select-filter">
    {t(locale, 'ui', 'Rarity')}
    <select
      class="home-native-select"
      name="rarity"
      aria-label={t(locale, 'ui', 'Rarity')}
    >
      {
        rarityOptions.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))
      }
    </select>
  </div>

  <div class="home-select-filter">
    {t(locale, 'ui', 'Specialty')}
    <select
      class="home-native-select"
      name="specialty"
      aria-label={t(locale, 'ui', 'Specialty')}
    >
      {
        specialtyOptions.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))
      }
    </select>
  </div>

  {
    hasRecentUpdates && (
      <label class="home-updated-toggle">
        <input
          class="home-updated-toggle-input"
          type="checkbox"
          name="updated"
          value="true"
        />
        <span class="home-updated-toggle-mark" aria-hidden="true" />
        <span class="home-updated-text">
          <span class="home-updated-toggle-title">{recentlyUpdatedLabel}</span>
          {versionText && (
            <span class="home-updated-toggle-version">{versionText}</span>
          )}
        </span>
        <span class="home-updated-toggle-count">{recentlyUpdatedCount}</span>
      </label>
    )
  }
</form>
