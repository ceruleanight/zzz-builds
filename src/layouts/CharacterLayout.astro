---
import { rankLabel } from '../utils/rank';
import '../styles/base.css';
import '../styles/build.css';
import '../styles/theme.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CalculationLinks from '../components/CalculationLinks.astro';
import BuildTips from '../components/BuildTips.astro';
import { t } from '../utils/i18n';
import { sitePath } from '../utils/paths';

const { character, characterSlug, metadata, lang, locale, builds = [], defaultBuildSlug } = Astro.props;
const characterArtAlt = t(locale, 'ui', 'Character art alt').replace('{name}', character);
const characterHeaderImage = metadata?.portrait ?? metadata?.image;
const buildLabel = t(locale, 'ui', 'Builds', undefined, false);
const bestRoleLabel = t(locale, 'ui', 'Best Role');
const versionLabel = t(locale, 'ui', 'Version');
const defaultBuild =
  builds.find((build: any) => build.slug === defaultBuildSlug && !build.isWip) ??
  builds.find((build: any) => !build.isWip);
const activeLastUpdated = defaultBuild?.lastUpdated ?? metadata?.last_updated;
const buildsWithTips = builds.filter((build: any) => !build.isWip && build.buildNote?.tips?.length > 0);
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>ZZZ Builds - {character}</title>
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.ico')} />
  </head>

  <body data-element={Astro.props.element}>
    <!-- The header needs the URL slug, not the localized display name. -->
    <Header locale={locale} lang={lang} character={characterSlug} />
    <div class="page character-page">
      <div class="character-page-layout">
        <aside class="character-header" aria-labelledby="character-title">
          <div class="character-art-stage">
            {
              characterHeaderImage ? (
                <img
                  class="character-image"
                  src={characterHeaderImage}
                  alt={characterArtAlt}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                  width={132}
                  height={132}
                  referrerpolicy="no-referrer"
                />
              ) : (
                <span class="image-placeholder character-image" aria-hidden="true">
                  {character.charAt(0)}
                </span>
              )
            }
          </div>

          <div class="character-header-copy">
            <h1 id="character-title" class="page-title" data-pagefind-body>
              {character}
            </h1>

            <div class="character-emblems" aria-hidden="true">
              <img
                class="character-emblem"
                src={sitePath(`icons/rank/${rankLabel(Astro.props.rarity).toLowerCase()}.png`)}
                alt=""
                title={`${rankLabel(Astro.props.rarity)}-${t(locale, 'ui', 'Rarity')}`}
                width="28"
                height="28"
              />
              <img
                class="character-emblem"
                src={sitePath(`icons/elements/${Astro.props.element}.webp`)}
                alt=""
                title={t(locale, 'element', Astro.props.element)}
                width="28"
                height="28"
              />
              <img
                class="character-emblem"
                src={sitePath(`icons/specialties/${metadata.specialty}.png`)}
                alt=""
                title={t(locale, 'ui', metadata.specialty)}
                width="28"
                height="28"
              />
            </div>

            <div class="character-header-meta">
              {
                activeLastUpdated && (
                  <div class="last-updated">
                    <span>{t(locale, 'ui', 'Last Updated')}</span>
                    <strong data-last-updated-value data-version-label={versionLabel}>
                      {versionLabel} {activeLastUpdated}
                    </strong>
                  </div>
                )
              }
            </div>
          </div>

          {
            builds.length > 0 && (
              <nav class="build-switcher" aria-label={buildLabel}>
                {builds.map((build: any) => {
                  const isDefaultBuild = build.slug === defaultBuildSlug && !build.isWip;

                  return (
                    <button
                      id={`build-tab-${build.slug}`}
                      class={`build-switcher-button${isDefaultBuild ? ' is-active' : ''}${build.isWip ? ' is-wip' : ''}`}
                      type="button"
                      data-build-tab
                      data-id={build.slug}
                      data-last-updated={build.lastUpdated}
                      disabled={build.isWip}
                      aria-disabled={build.isWip ? 'true' : undefined}
                      aria-controls={`build-content-${build.slug}`}
                      aria-pressed={isDefaultBuild ? 'true' : 'false'}
                    >
                      <span class="build-switcher-name">{build.name}</span>
                      <span class="build-switcher-tags">
                        {build.lastUpdated && <span class="build-version-badge">{build.lastUpdated}</span>}
                        {build.isBest && <span class="build-badge">{bestRoleLabel}</span>}
                      </span>
                    </button>
                  );
                })}
              </nav>
            )
          }

          {
            buildsWithTips.length > 0 && (
              <section
                class="build-tips-section"
                data-build-tips-section
                hidden={!defaultBuild?.buildNote?.tips?.length}
              >
                <h2>{t(locale, 'ui', 'Gameplay Tips')}</h2>
                {buildsWithTips.map((build: any) => (
                  <div data-build-tips-panel data-id={build.slug} hidden={build.slug !== defaultBuildSlug}>
                    <BuildTips tips={build.buildNote.tips} />
                  </div>
                ))}
              </section>
            )
          }

          {
            builds.length > 0 && (
              <div class="build-calculation-panels">
                {builds
                  .filter((build: any) => build.hasCalculations)
                  .map((build: any) => {
                    const isDefaultBuild = build.slug === defaultBuildSlug && !build.isWip;

                    return (
                      <div
                        class={`build-calculation-panel${isDefaultBuild ? ' is-active' : ''}`}
                        data-build-calculation-panel
                        data-id={build.slug}
                        hidden={!isDefaultBuild}
                        aria-hidden={isDefaultBuild ? 'false' : 'true'}
                      >
                        <CalculationLinks buildNote={build.buildNote} locale={locale} />
                      </div>
                    );
                  })}
              </div>
            )
          }
        </aside>

        <div class="character-main">
          <slot />
        </div>
      </div>
    </div>
    <Footer lang={lang} />
  </body>
</html>
